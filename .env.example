# API Key（必填）
# 官方: https://console.anthropic.com/
# DeepSeek（Anthropic 兼容端点）: https://platform.deepseek.com/api_keys
ANTHROPIC_API_KEY=sk-xxx

# 模型 ID（必填）
MODEL_ID=deepseek-chat

# Base URL（可选）
# 默认 Anthropic 官方；接 DeepSeek 时填其 Anthropic 兼容端点:
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#
# 常用 Anthropic 兼容提供方:
#   DeepSeek   https://api.deepseek.com/anthropic        deepseek-chat / deepseek-reasoner
#   GLM        https://api.z.ai/api/anthropic            glm 系列
#   Kimi       https://api.moonshot.cn/anthropic         kimi 系列
#   MiniMax    https://api.minimaxi.com/anthropic        MiniMax 系列
